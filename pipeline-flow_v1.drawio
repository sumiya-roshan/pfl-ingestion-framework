        </mxCell>
        <mxCell id="shadow1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#D5D9DE;" value="" vertex="1">
          <mxGeometry height="426" width="1600" x="-322" y="628" as="geometry" />
        </mxCell>
        <mxCell id="thread-container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C97A8;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=10;fontStyle=2;fontColor=#8C97A8;" value="1 of N threads running in parallel" vertex="1">
          <mxGeometry height="426" width="1600" x="-330" y="622" as="geometry" />
        </mxCell>
        <mxCell id="edge-fork" edge="1" parent="1" source="box3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A85A16;fontColor=#5B6672;fontSize=10;endArrow=block;endFill=1;" target="sub0" value="filtered_tasks_metadata → one thread per table">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sub0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1B222C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="Task 1 Lookup - COUNT(*) check for this table&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(91, 102, 114);&quot;&gt;0 rows → SKIPPED audit row written, thread exits here · otherwise continue to Raw&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(74, 106, 136); font-family: monospace;&quot;&gt;LookupExecutor._lookup_one(source_sys, task) → count, resolved_query&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: #8C97A8; font-style: italic;&quot;&gt;fail-safe — never raises, so no FAILED email fires from this step&lt;/font&gt;" vertex="1">
          <mxGeometry height="84" width="720" x="60" y="646" as="geometry" />
        </mxCell>
        <mxCell id="sub1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD3;strokeColor=#B9770E;fontColor=#1B222C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="Raw - Task 2 main.py: extract source table → write raw file to S3&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#8A6A2F;font-family:monospace;&quot;&gt;orchestrator.run(source_sys, task, config_master_id, landing_volume_path, trigger_id, job_context)&lt;/font&gt;" vertex="1">
          <mxGeometry height="58" width="720" x="60" y="740" as="geometry" />
        </mxCell>
        <mxCell id="sub2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4ECF3;strokeColor=#2F5A82;fontColor=#1B222C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="Silver - silver_transform.ipynb: read raw file from S3 → write Silver Delta table&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(91, 102, 114);&quot;&gt;notebook, triggered inline in the same thread right after the raw write&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4A6A88;font-family:monospace;&quot;&gt;_trigger_silver(config_id, source_system_id, landing_path, silver_catalog/schema/table, dependency_table)&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="720" x="60" y="808" as="geometry" />
        </mxCell>
        <mxCell id="sub3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEDF1;strokeColor=#1B222C;fontColor=#1B222C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="Resolve dependency - update child config table dates, set dependency_resolve_time =&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;Activity_End_Time(the exact timestamp the Silver pipeline successfully finished)&lt;/span&gt;" vertex="1">
          <mxGeometry height="64" width="720" x="60" y="882" as="geometry" />
        </mxCell>
        <mxCell id="sub4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEDF1;strokeColor=#1B222C;fontColor=#1B222C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="Audit log - write this table&#39;s FINAL run status (SUCCESS / FAILED)&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(91, 102, 114);&quot;&gt;closing update — the arrows either side show every step&#39;s own outcome too&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;font-family:monospace;&quot;&gt;audit.complete_run(audit_run, status, rows_read, rows_copied, data_written_bytes, throughput_mb_per_sec)&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="720" x="60" y="956" as="geometry" />
        </mxCell>
        <mxCell id="edge-sub0" edge="1" parent="1" source="sub0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" target="sub1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-sub1" edge="1" parent="1" source="sub1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B9770E;endArrow=block;endFill=1;" target="sub2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-sub2" edge="1" parent="1" source="sub2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2F5A82;endArrow=block;endFill=1;" target="sub3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-sub3" edge="1" parent="1" source="sub3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B222C;endArrow=block;endFill=1;" target="sub4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==== Audit table — now inside the widened thread-pool boundary, right side ==== -->
        <mxCell id="audit-table" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEDF1;strokeColor=#1B222C;fontColor=#1B222C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="tb_audit_log (Audit log table)&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(91, 102, 114);&quot;&gt;one row per step, per table, per run&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(68, 68, 68); font-family: monospace;&quot;&gt;table_id, delta_layer, status, error_code, error_message, rows_read, rows_copied&lt;/font&gt;" vertex="1">
          <mxGeometry height="280" width="270" x="980" y="700" as="geometry" />
        </mxCell>
        <mxCell id="edge-audit0" edge="1" parent="1" source="sub0" target="audit-table" style="html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" value="SKIPPED (0 rows)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-audit1" edge="1" parent="1" source="sub1" target="audit-table" style="html=1;strokeColor=#B9770E;endArrow=block;endFill=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" value="INPROGRESS · FAILED on error">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-audit2" edge="1" parent="1" source="sub2" target="audit-table" style="html=1;strokeColor=#2F5A82;endArrow=block;endFill=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="FAILED on error">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-audit3" edge="1" parent="1" source="sub3" target="audit-table" style="html=1;strokeColor=#1B222C;endArrow=block;endFill=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" value="FAILED here also fails the table (same try block, not caught separately)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-audit4" edge="1" parent="1" source="sub4" target="audit-table" style="html=1;strokeColor=#1B222C;endArrow=block;endFill=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" value="SUCCESS / FAILED (final)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==== NEW: Email notification — inside the thread pool too, left side ==== -->
        <mxCell id="mail-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E9F0;strokeColor=#8E4C7A;fontColor=#1B222C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="Email notification (per step, per table)&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(91, 102, 114);&quot;&gt;on FAILURE (Raw / Silver / Resolve dependency / final) → always notify the configured recipients&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(91, 102, 114);&quot;&gt;on SUCCESS (final only) → notify only recipients marked eligible for success in the recipient config table&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(142, 76, 122); font-family: monospace;&quot;&gt;recipient config table: pipeline_name, recipient_email, notify_on_success (name TBD)&lt;/font&gt;" vertex="1">
          <mxGeometry height="280" width="270" x="-300" y="700" as="geometry" />
        </mxCell>
        <mxCell id="edge-mail1" edge="1" parent="1" source="sub1" target="mail-box" style="html=1;strokeColor=#B9770E;endArrow=block;endFill=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.15;entryDx=0;entryDy=0;" value="FAILED here → notify (fails the table)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-mail2" edge="1" parent="1" source="sub2" target="mail-box" style="html=1;strokeColor=#2F5A82;endArrow=block;endFill=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" value="FAILED here → notify (fails the table)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-mail3" edge="1" parent="1" source="sub3" target="mail-box" style="html=1;strokeColor=#1B222C;endArrow=block;endFill=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" value="FAILED here → notify (same try block, also fails the table)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-mail4f" edge="1" parent="1" source="sub4" target="mail-box" style="html=1;strokeColor=#1B222C;endArrow=block;endFill=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" value="FAILED (final) → notify all configured recipients">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-mail4s" edge="1" parent="1" source="sub4" target="mail-box" style="html=1;strokeColor=#8E4C7A;endArrow=block;endFill=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" value="SUCCESS (final) → notify only recipients enabled for success">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="lbl-state" parent="1" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#5B6672;align=left;" value="SHARED STATE" vertex="1">
          <mxGeometry height="18" width="300" x="40" y="1068" as="geometry" />
        </mxCell>
        <mxCell id="box9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAEDF1;strokeColor=#1B222C;fontColor=#1B222C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="dependency_master_config.dependency_resolve_time&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5B6672;&quot;&gt;NULL = not ready · a timestamp = safe to consume, safe to re-eligible&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;font-family:monospace;&quot;&gt;row key: (config_id, source_system_id) · columns: job_run_id, business_date, pipeline_start_time, pipeline_end_time, dependency_resolve_time&lt;/font&gt;" vertex="1">
          <mxGeometry height="72" width="760" x="40" y="1096" as="geometry" />
        </mxCell>
        <mxCell id="edge-join" edge="1" parent="1" source="sub4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B222C;fontColor=#5B6672;fontSize=10;endArrow=block;endFill=1;" target="box9" value="threads join → result dict returned to main.py">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-loop" edge="1" parent="1" source="box9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A85A16;fontColor=#A85A16;fontSize=10;dashed=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="box1" value="polled by the scheduler on every iteration">
          <mxGeometry relative="1" x="-0.0081" y="60" as="geometry">
