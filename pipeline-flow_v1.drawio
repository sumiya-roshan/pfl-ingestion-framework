<mxfile host="app.diagrams.net" agent="claude-code">
  <diagram name="Pipeline Flow" id="pipeline-flow">
    <mxGraphModel dx="2473" dy="663" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1B222C;" value="How a table gets refreshed, end to end" vertex="1">
          <mxGeometry height="30" width="760" x="40" as="geometry" />
        </mxCell>
        <mxCell id="lbl-scheduler" parent="1" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#A85A16;align=left;" value="MULTI-REFRESH SCHEDULER · loops till all tables are refreshed" vertex="1">
          <mxGeometry height="18" width="600" x="40" y="58" as="geometry" />
        </mxCell>
        <mxCell id="box1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6E9DA;strokeColor=#A85A16;fontColor=#1B222C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="Scan tb_report_batch_run_config&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#5B6672;&quot;&gt;is any table&#39;s refresh window open right now?&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#8A7357;font-family:monospace;&quot;&gt;columns: Config_Master_ID, Config_ID, Refresh_Time, Next_Refresh_Time, Last_Sink_Date, Is_Active&lt;/font&gt;" vertex="1">
          <mxGeometry height="74" width="760" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="box-decide" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF3E7;strokeColor=#C08A3E;fontColor=#1B222C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="Decide which of those tables are eligible&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(91, 102, 114);&quot;&gt;Day_Status_Flag = 1 → row exists in ingestion_config table : Day_Execution_Count &amp;gt; 0 AND Sink_Batch_Started_Date = today&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(91, 102, 114);&quot;&gt;Current_Status_Flag = 1 → row exists in dependency_master_config with dependency_resolve_time IS NULL (still unresolved)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(138, 115, 87); font-family: monospace;&quot;&gt;eligible = Current_Status_Flag = 0 AND Day_Status_Flag = 1&lt;/font&gt;" vertex="1">
          <mxGeometry height="98" width="760" x="40" y="164" as="geometry" />
        </mxCell>
        <mxCell id="edge-scan-decide" edge="1" parent="1" source="box1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A85A16;endArrow=block;endFill=1;" target="box-decide">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box-pipeline-map" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF3E7;strokeColor=#C08A3E;fontColor=#1B222C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="Map eligible rows back to the config table get the Pipeline_Name&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(91, 102, 114);&quot;&gt;for each eligible (Config_Master_ID, Config_ID), looked up one row at a time in ingestion_config · no match found → that table is dropped from the eligible set&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(138, 115, 87); font-family: monospace;&quot;&gt;eligible_df.collect() → per-row lookup → eligible_df rebuilt with Pipeline_Name attached&lt;/font&gt;" vertex="1">
          <mxGeometry height="76" width="760" x="40" y="278" as="geometry" />
        </mxCell>
        <mxCell id="edge-decide-map" edge="1" parent="1" source="box-decide" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A85A16;endArrow=block;endFill=1;" target="box-pipeline-map">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6E9DA;strokeColor=#A85A16;fontColor=#1B222C;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="POST /jobs/run-now&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;MERGE dependency_resolve_time = null,&amp;nbsp;sink_batch_started_date = {trigger_time}, statu = &#39;In-progress&#39;,&amp;nbsp;Last_Sink_Date =&amp;nbsp;MAX(modification_time_IST)&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 10px; color: rgb(91, 102, 114);&quot;&gt;JobTrigger REST call - fires the child ingestion job by name&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px; color: rgb(138, 115, 87); font-family: monospace;&quot;&gt;run_now_by_name(job_name, notebook_params={batch_start_date, pipeline_name})&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="94" width="760" x="40" y="370" as="geometry" />
        </mxCell>
        <mxCell id="edge1" edge="1" parent="1" source="box-pipeline-map" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A85A16;fontColor=#A85A16;fontSize=10;endArrow=block;endFill=1;" target="box2" value="eligible tables, now with pipeline_name">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lbl-job" parent="1" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#5B6672;align=left;" value="INGESTION JOB" vertex="1">
          <mxGeometry height="18" width="300" x="40" y="480" as="geometry" />
        </mxCell>
        <mxCell id="box3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=6;" value="Task 0 - get_tasks: fetch active config rows&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: rgb(91, 102, 114);&quot;&gt;publishes the task list via taskValues&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4A6A88;font-family:monospace;&quot;&gt;widgets: config_master_id, source_system_id, pipeline_name, batch_start_date → taskValues[active_tasks_metadata]&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="760" x="40" y="502" as="geometry" />
        </mxCell>
        <mxCell id="_OYlN9YI7tSGRjv8dXXc-1" edge="1" parent="1" source="box3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="_OYlN9YI7tSGRjv8dXXc-2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="810" y="534" />
              <mxPoint x="810" y="534" />
            </Array>
            <mxPoint x="830" y="536" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_OYlN9YI7tSGRjv8dXXc-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="batch_start_date = 1 if the job is triggered independently; batch_start_date = {trigger_time} if from Multi refresh job trigger (passed via params)" vertex="1">
          <mxGeometry height="27" width="250" x="860" y="521" as="geometry" />
        </mxCell>
        <mxCell id="lbl-parallel" parent="1" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#5B6672;align=left;" value="THREAD POOL · one thread per table from Task 0 · tables run concurrently · audit + email notification both live inside this thread too" vertex="1">
          <mxGeometry height="18" width="900" x="40" y="580" as="geometry" />
        </mxCell>
        <mxCell id="shadow2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F2;strokeColor=#DDE1E6;" value="" vertex="1">
