<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Mavis API Export Flow" id="mavis-api-flow">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="LSQ Mavis — API Export Flow (start &#8594; poll &#8594; download URL &#8594; download/unzip to S3)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- ── Config inputs (left) ─────────────────────────────────────────── -->
        <mxCell id="cfgTask" value="MavisIngestionTaskConfig  (one config-table row, built by ConfigManager._build_mavis_task)&#10;&#10;config_id, org_code, database_id, table_id&#10;api_key&#10;source_filter, load_type, to_date, sink_batch_started_date&#10;s3_raw_landing_path&#10;raw_container_name / raw_folder_path / raw_file_name&#10;child_table_fqn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="300" height="170" as="geometry" />
        </mxCell>

        <mxCell id="cfgApi" value="MavisApiConfig  (HTTP / polling settings)&#10;&#10;prod_api                (ADF Prod_API base URL)&#10;start_export_path / status_path / download_url_path&#10;request_timeout_seconds&#10;poll_interval_seconds / poll_max_attempts&#10;done_statuses / failed_statuses" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="300" height="150" as="geometry" />
        </mxCell>

        <!-- ── Main flow (centre) ───────────────────────────────────────────── -->
        <mxCell id="entry" value="api_export_main.py  (Databricks Job task)&#10;&#10;reads active_tasks_metadata from taskValues&#10;(fallback: ConfigManager.get_active_tasks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="430" y="70" width="360" height="70" as="geometry" />
        </mxCell>

        <mxCell id="loop" value="for task in tasks  —  SEQUENTIAL&#10;MavisApiExtractor.run(task)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1">
          <mxGeometry x="450" y="180" width="320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="inprog" value="ConfigManager.update_status(child_table_fqn, config_id, INPROGRESS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=center;" vertex="1" parent="1">
          <mxGeometry x="430" y="270" width="360" height="40" as="geometry" />
        </mxCell>

        <mxCell id="step1" value="1.  start_export(task)  &#8594;  RequestId&#10;&#10;POST {prod_api}{database_id}/{table_id}/rows/export?orgcode={org_code}&#10;Headers:  x-api-key: &lt;Api_Key&gt;   (never logged),  Content-Type: application/json&#10;Body = Source_Filter&#10;  &#8226; FULL         : sent as-is&#10;  &#8226; INCREMENTAL  : replace  from_date &#8594; To_Date,  to_date &#8594; sink_batch_started_date&#10;                 (both yyyy-MM-dd HH:mm:ss)&#10;&#10;Response &#8594; RequestId / RequestID    (missing &#8594; RuntimeError)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="350" width="420" height="180" as="geometry" />
        </mxCell>

        <mxCell id="step2" value="2.  poll_until_ready(task, RequestId)&#10;&#10;POST {prod_api}{database_id}/tables/{table_id}/requesthistory?orgcode={org_code}&#10;Body = { &quot;Parameter&quot;: { &quot;RequestId&quot;: &lt;RequestId&gt; } }&#10;status = _extract_status(response)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="570" width="420" height="110" as="geometry" />
        </mxCell>

        <mxCell id="dDone" value="status in&#10;done_statuses?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="520" y="710" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="dFail" value="status in&#10;failed_statuses?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="870" y="575" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="sleep" value="sleep(poll_interval_seconds)&#10;attempt++&#10;stop after poll_max_attempts &#8594; RuntimeError" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1">
          <mxGeometry x="870" y="710" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="step3" value="3.  get_download_url(task, RequestId)  &#8594;  FileURL&#10;&#10;POST {prod_api}{database_id}/{table_id}/request/download?orgcode={org_code}&#10;Body = { &quot;RequestID&quot;: &lt;RequestId&gt;, &quot;FileType&quot;: &quot;ExportedFile&quot; }&#10;&#10;Response &#8594; FileURL / FileUrl     (missing &#8594; RuntimeError)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="850" width="420" height="140" as="geometry" />
        </mxCell>

        <mxCell id="step4" value="4.  download_and_extract_to_s3(task, FileURL)      [ handled separately — out of API scope ]&#10;&#10;GET FileURL (stream)  &#8594;  local temp .zip&#10;dbutils.fs.cp  &#8594;  S3 zip path   ({landing}/{container}/{folder}/zip/YYYY/Mon/DD/{file}_{ts}.zip)&#10;unzip first CSV  &#8594;  dbutils.fs.cp  &#8594;  S3 csv path (…/unzip/…)&#10;&#8594; { s3_zip_path, s3_csv_path }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="1030" width="420" height="130" as="geometry" />
        </mxCell>

        <mxCell id="success" value="ConfigManager.update_status(SUCCESS)&#10;results[config_id] = (SUCCESS, paths)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" vertex="1" parent="1">
          <mxGeometry x="430" y="1210" width="360" height="50" as="geometry" />
        </mxCell>

        <mxCell id="summary" value="Summary&#10;print SUCCESS / FAILED config_ids&#10;raise RuntimeError if any FAILED,  else dbutils.notebook.exit(...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="430" y="1320" width="360" height="80" as="geometry" />
        </mxCell>

        <!-- ── Failure path (right) ─────────────────────────────────────────── -->
        <mxCell id="fail" value="RuntimeError from any step&#10;&#10;MavisApiExtractor.run:&#10;  ConfigManager.update_status(FAILED)&#10;  re-raise&#10;&#10;api_export_main:&#10;  results[config_id] = (FAILED, msg)&#10;  other tasks CONTINUE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="850" width="220" height="200" as="geometry" />
        </mxCell>

        <!-- ── Edges ────────────────────────────────────────────────────────── -->
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="entry" target="loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="loop" target="inprog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="inprog" target="step1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="step2" target="dDone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dDone" target="dFail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dDone" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dFail" target="sleep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="dFail" target="fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="sleep" target="step2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1080" y="625" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="step4" target="success">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="next task" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="success" target="loop">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="410" y="1235" />
              <mxPoint x="410" y="205" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" value="all tasks done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="loop" target="summary">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="810" y="205" />
              <mxPoint x="810" y="1360" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e14" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="step1" target="fail">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="990" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e15" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="step3" target="fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="step4" target="fail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="next task (others continue)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="fail" target="loop">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="990" y="205" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="cfgTask" target="loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="cfgApi" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
